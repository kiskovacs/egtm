{cover_enabled, false}.
{eunit_opts, [verbose]}.

{erl_opts, [

  %% Important for BEAM reconstruction!!!
  debug_info
]}.

%% folsom is optional: add it yourself to use EGTM_METRICS
{deps, [
  {deepprops, {git, "https://github.com/keynslug/deepprops.git", {branch, "master"}}}
]}.

%% GT.M call-in NIF (YottaDB location: EGTM_DIST or pkg-config yottadb)
{pre_hooks, [{compile, "make -C c_src"}]}.
{post_hooks, [{clean, "make -C c_src clean"}]}.

%% `rebar3 as pool compile|eunit' builds with worker-pool support
{profiles, [
  {pool, [{erl_opts, [{d, 'EGTM_POOL_ENABLED'}]}]}
]}.

