#!/bin/sh

. `dirname $0`/gtmenv

DIR=`pwd` ; CMD_PRIV=`dirname $0` ; cd ${CMD_PRIV} ; CMD_PRIV=`pwd` ; cd $DIR

mkdir -p "${EGTM_GBLS}" "${EGTM_OBJ}" || exit 1

if [ -f ${EGTM_DB_DEFAULT:-""} ] ; then
  #echo "Database already exists!"
  #echo "*** NOT INITIALIZING IT ***"
  exit 0
fi

$gtm_dist/mumps -r ^GDE << EOF
DELETE -REGION DEFAULT
DELETE -SEGMENT DEFAULT
TEMPLATE -SEGMENT -Bloc=4096
TEMPLATE -SEGMENT -Lock=40
TEMPLATE -SEGMENT -Glob=4096
TEMPLATE -SEGMENT -Alloc=1000
TEMPLATE -SEGMENT -Ext=3000
TEMPLATE -REGION -Rec=4080
TEMPLATE -REGION -Key=255
TEMPLATE -REGION -N=AL
TEMPLATE -REGION -JOURNAL=(BEFORE_IMAGE)
ADD -SEGMENT EGTM -F="\$EGTM_DB_DEFAULT"
ADD -SEGMENT EGTMBIG -BLOCK=32256 -F="\$EGTM_DB_BIG"
ADD -REGION EGTM -D=EGTM
ADD -REGION EGTMBIG -REC=32240 -D=EGTMBIG
LOCKS -REGION=EGTM
CHANGE -NAME * -R=EGTM
ADD -NAME Big* -R=EGTMBIG
SHOW -ALL
VERIFY -ALL
EXIT
EOF

$gtm_dist/mupip create

